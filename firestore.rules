rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The public landing page needs these documents to show the current offers
    // and content, while changes remain limited to Firebase-authenticated admins.
    match /proposals/{proposalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/landingPage {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Visitors can submit a PDF request, but cannot read, edit or remove the
    // contact list. Only an authenticated administrator can read it.
    match /pdfRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
        'clientName', 'clientPhone', 'clientEmail', 'clientCpf',
        'proposalType', 'proposalTitle', 'serviceType', 'guestRange', 'createdAt'
      ])
      && request.resource.data.clientName is string
      && request.resource.data.clientPhone is string
      && request.resource.data.clientEmail is string
      && request.resource.data.clientCpf is string
      && request.resource.data.proposalType in ['completa', 'cerimonial']
      && request.resource.data.proposalTitle is string
      && request.resource.data.serviceType is string
      && request.resource.data.guestRange is string
      && request.resource.data.createdAt == request.time;

      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
